# Render environment variables for the notification-only service
NOTIFICATION_API_KEY=replace-with-a-long-random-key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_SUBJECT=mailto:admin@example.com
IMGBB_API_KEY=replace-with-imgbb-key
CORS_ORIGINS=https://your-website.example
