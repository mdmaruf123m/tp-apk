<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Standard Template Theme with Splash Background & Edge-to-Edge Support -->
    <style name="Theme.AppTemplate" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
    </style>

    <!-- Fullscreen / Immersive Variant Configurable via APPLICATION_THEME=Theme.AppTemplate.FullScreen -->
    <style name="Theme.AppTemplate.FullScreen" parent="Theme.AppTemplate">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Backwards compatibility alias -->
    <style name="Theme.MyApplication" parent="Theme.AppTemplate" />

</resources>
